<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fa76c43c-f6d0-41fd-bdcd-214ccae74d41</groupId>
    <artifactId>output-quality-demo-agent</artifactId>
    <version>1.1.0</version>
    <packaging>mule-application</packaging>
    <name>output-quality-demo-agent</name>
    <description>Demo chat agent (OpenAI-compatible) with scripted misbehaviour modes, used to demonstrate the Output Quality &amp; Anomaly Detection policy.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <app.runtime>4.12.3</app.runtime>
        <mule.maven.plugin.version>4.10.2</mule.maven.plugin.version>
        <anypoint.environment>Sandbox</anypoint.environment>
        <anypoint.privateSpace>clee-inc-ps</anypoint.privateSpace>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <cloudhub2Deployment>
                        <uri>https://anypoint.mulesoft.com</uri>
                        <provider>MC</provider>
                        <environment>${anypoint.environment}</environment>
                        <target>${anypoint.privateSpace}</target>
                        <muleVersion>${app.runtime}</muleVersion>
                        <javaVersion>17</javaVersion>
                        <applicationName>output-quality-demo-agent</applicationName>
                        <replicas>1</replicas>
                        <vCores>0.1</vCores>
                        <connectedAppClientId>${anypoint.connectedApp.clientId}</connectedAppClientId>
                        <connectedAppClientSecret>${anypoint.connectedApp.clientSecret}</connectedAppClientSecret>
                        <connectedAppGrantType>client_credentials</connectedAppGrantType>
                        <deploymentSettings>
                            <generateDefaultPublicUrl>true</generateDefaultPublicUrl>
                            <lastMileSecurity>false</lastMileSecurity>
                        </deploymentSettings>
                        <properties>
                            <openai.model>gpt-5.4-mini</openai.model>
                        </properties>
                        <!-- Set openai.apiKey as a secure property in Runtime Manager (or pass -Dopenai.apiKey at deploy). -->
                    </cloudhub2Deployment>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.mulesoft.connectors</groupId>
            <artifactId>mule4-a2a-connector</artifactId>
            <version>2.0.0</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>1.12.2</version>
            <classifier>mule-plugin</classifier>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <layout>default</layout>
            <url>https://repository.mulesoft.org/releases/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
